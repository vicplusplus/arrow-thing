# Template for all `.env` files in the Arrow Thing stack. The same filename
# lives in several places with different responsibilities — copy this file
# and uncomment only the keys relevant to that location.
#
# Locations:
#   - server/.env (local dev): read by local_startup.sh + admin.sh.
#   - /home/deploy/arrow-thing/.env (production VPS): read by docker-compose
#     to populate the api / worker / grafana containers. Must be
#     `chmod 600` root- or deploy-owned.
#
# Secrets NEVER belong in this file:
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, UNITY_LICENSE, UNITY_EMAIL,
#   UNITY_PASSWORD, DISCORD_WEBHOOK_URL, VPS_SSH_KEY, VPS_HOST,
#   VPS_KNOWN_HOSTS — all GitHub Secrets, CI-only.

# -- Postgres (prod VPS + local dev) ---------------------------------------
POSTGRES_USER=arrowthing
POSTGRES_PASSWORD=
POSTGRES_DB=arrowthing

# -- Auth secrets (prod VPS) ----------------------------------------------
# JWT signing key. Must be >=32 bytes and must NOT match a known dev default
# (see StartupSecretValidator). Generate with `openssl rand -base64 48`.
JWT_SECRET=
# Admin API key for /api/admin/* endpoints served by the prod API.
# Generate with `openssl rand -base64 24`.
ADMIN_API_KEY=
# Separate admin key for `admin.sh --prod` invocations from a developer's
# laptop. Same value as ADMIN_API_KEY on the VPS — keeping the local copy
# in a different var prevents accidental dev-key use in prod. Local dev
# sessions that never touch prod can leave this blank.
PROD_ADMIN_API_KEY=

# -- Cookie / CORS (prod VPS, Phase 1D) -----------------------------------
# Cookie Domain. Must be set so HttpOnly cookies are shared between
# arrow-thing.com (game) and api.arrow-thing.com (API). Leave blank for
# localhost / host-only cookies.
Auth__Cookies__Domain=.arrow-thing.com
# Cookies sent only over HTTPS. Always true in prod; false locally.
Auth__Cookies__Secure=true
# CORS allow-list for cookie-authed requests. ASP.NET array binding —
# use __0, __1, … to supply multiple origins.
Cors__AllowedOrigins__0=https://arrow-thing.com

# -- Email (prod VPS — Resend) --------------------------------------------
Resend__ApiKey=
Resend__FromAddress=noreply@arrow-thing.com

# -- Redis (local dev only; prod uses Docker service name `redis`) --------
REDIS_CONNECTION_STRING=localhost:6379

# -- Environment ----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production

# -- Grafana (prod VPS) ---------------------------------------------------
# Used only by the Grafana container for its built-in admin login; not
# exposed externally (Grafana binds to 127.0.0.1:3000 behind SSH tunnel).
GRAFANA_ADMIN_PASSWORD=

# -- Staging (prod VPS only) ----------------------------------------------
# The staging stack runs alongside prod on the same VPS (see
# server/deploy/docker-compose.yml staging services). It must use
# completely separate credentials — a compromised staging secret must
# not grant any prod access. Generate fresh values; do not reuse prod
# secrets. Resend__ApiKey is intentionally shared (both environments
# send from the same domain).
STAGING_POSTGRES_USER=arrowthing
STAGING_POSTGRES_PASSWORD=
STAGING_POSTGRES_DB=arrowthing_staging
STAGING_JWT_SECRET=
STAGING_ADMIN_API_KEY=
STAGING_ASPNETCORE_ENVIRONMENT=Staging
STAGING_Resend__FromAddress=noreply@staging.arrow-thing.com
# Cookie Domain — leave blank for host-only cookies. Staging uses a
# same-origin Pages Function proxy (pages-staging/functions/api/[[path]].js)
# so /api/* on staging.arrow-thing.com transparently reaches the API
# container. A Domain like .staging.arrow-thing.com would NOT cover
# api-staging.arrow-thing.com (sibling subdomain, not child) and the
# browser would silently drop the Set-Cookie response.
STAGING_Auth__Cookies__Domain=
STAGING_Cors__AllowedOrigins__0=https://staging.arrow-thing.com
