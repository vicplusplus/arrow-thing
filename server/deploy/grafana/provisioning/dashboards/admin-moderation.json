{
  "uid": "admin-moderation",
  "title": "Admin & Moderation",
  "tags": ["arrow-thing"],
  "timezone": "utc",
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Server Health",
      "type": "link",
      "url": "/d/server-health",
      "icon": "heart"
    },
    {
      "title": "Scores & Leaderboard",
      "type": "link",
      "url": "/d/scores-leaderboard",
      "icon": "table"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Total Users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Total Users\" FROM \"Users\";",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "title": "Verified",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Verified\" FROM \"Users\" WHERE \"EmailVerifiedAt\" IS NOT NULL;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Flagged",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Flagged\" FROM \"Users\" WHERE \"Flagged\" = true;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "title": "Locked",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Locked\" FROM \"Users\" WHERE \"LockedAt\" IS NOT NULL;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "title": "Flagged Accounts",
      "description": "All currently flagged accounts with reason",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT u.\"Id\", u.\"DisplayName\" AS \"Display Name\", u.\"Email\", u.\"FlagReason\" AS \"Flag Reason\", u.\"CreatedAt\" AS \"Account Created\", COUNT(s.\"Id\") AS \"Scores\" FROM \"Users\" u LEFT JOIN \"Scores\" s ON s.\"UserId\" = u.\"Id\" WHERE u.\"Flagged\" = true GROUP BY u.\"Id\", u.\"DisplayName\", u.\"Email\", u.\"FlagReason\", u.\"CreatedAt\" ORDER BY u.\"CreatedAt\" DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Id" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          },
          {
            "matcher": { "id": "byName", "options": "Flag Reason" },
            "properties": [{ "id": "custom.width", "value": 300 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Account Created", "desc": true }]
      }
    },
    {
      "id": 6,
      "title": "Locked Accounts",
      "description": "Admin-locked accounts",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT u.\"Id\", u.\"DisplayName\" AS \"Display Name\", u.\"Email\", u.\"LockedAt\" AS \"Locked At\" FROM \"Users\" u WHERE u.\"LockedAt\" IS NOT NULL ORDER BY u.\"LockedAt\" DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Locked At", "desc": true }]
      }
    },
    {
      "id": 7,
      "title": "Suspicious: Verification Failures",
      "description": "Accounts flagged by the verification worker",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT u.\"DisplayName\" AS \"Display Name\", u.\"Email\", u.\"FlagReason\" AS \"Reason\" FROM \"Users\" u WHERE u.\"Flagged\" = true AND u.\"FlagReason\" LIKE 'verification_failed:%' ORDER BY u.\"CreatedAt\" DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "id": 8,
      "title": "Audit Log (Recent)",
      "description": "Last 100 audit events",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT a.\"Timestamp\" AS \"Time\", a.\"Event\", a.\"Email\", a.\"IpAddress\" AS \"IP\", a.\"Detail\" FROM \"AuditLogs\" a WHERE a.\"Timestamp\" >= $__timeFrom()::timestamptz AND a.\"Timestamp\" <= $__timeTo()::timestamptz ORDER BY a.\"Timestamp\" DESC LIMIT 100;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Detail" },
            "properties": [{ "id": "custom.width", "value": 400 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": true }]
      }
    },
    {
      "id": 9,
      "title": "Audit Events by Type",
      "description": "Event distribution in selected time range",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT a.\"Event\", COUNT(*) AS \"Count\" FROM \"AuditLogs\" a WHERE a.\"Timestamp\" >= $__timeFrom()::timestamptz AND a.\"Timestamp\" <= $__timeTo()::timestamptz GROUP BY a.\"Event\" ORDER BY \"Count\" DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "xField": "Event",
        "orientation": "horizontal"
      }
    },
    {
      "id": 10,
      "title": "Failed Logins",
      "description": "Failed login attempts grouped by email in selected time range",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT a.\"Email\", a.\"IpAddress\" AS \"IP\", COUNT(*) AS \"Attempts\", MAX(a.\"Timestamp\") AS \"Last Attempt\" FROM \"AuditLogs\" a WHERE a.\"Event\" = 'login_failed' AND a.\"Timestamp\" >= $__timeFrom()::timestamptz AND a.\"Timestamp\" <= $__timeTo()::timestamptz GROUP BY a.\"Email\", a.\"IpAddress\" ORDER BY \"Attempts\" DESC LIMIT 50;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Attempts", "desc": true }]
      }
    },
    {
      "id": 11,
      "title": "Registrations Over Time",
      "description": "New account registrations per day",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 36 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroup(a.\"Timestamp\", '1d') AS time, COUNT(*) AS \"Registrations\" FROM \"AuditLogs\" a WHERE a.\"Event\" = 'register' AND $__timeFilter(a.\"Timestamp\") GROUP BY 1 ORDER BY 1;",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 0
          },
          "color": { "fixedColor": "blue", "mode": "fixed" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 12,
      "title": "Suspicious: Duplicate Seeds",
      "description": "Accounts flagged for submitting a seed already used by another player",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT u.\"DisplayName\" AS \"Display Name\", u.\"Email\", u.\"CreatedAt\" AS \"Account Created\" FROM \"Users\" u WHERE u.\"Flagged\" = true AND u.\"FlagReason\" = 'duplicate_seed' ORDER BY u.\"CreatedAt\" DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    }
  ],
  "templating": { "list": [] }
}
