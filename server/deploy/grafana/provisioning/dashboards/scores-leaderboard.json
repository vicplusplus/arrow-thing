{
  "uid": "scores-leaderboard",
  "title": "Scores & Leaderboard",
  "tags": ["arrow-thing"],
  "timezone": "utc",
  "refresh": "5m",
  "time": { "from": "now-7d", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "Server Health",
      "type": "link",
      "url": "/d/server-health",
      "icon": "heart"
    },
    {
      "title": "Admin & Moderation",
      "type": "link",
      "url": "/d/admin-moderation",
      "icon": "shield"
    }
  ],
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Total Scores",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Total Scores\" FROM \"Scores\";",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "title": "Scores Today",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) AS \"Today\" FROM \"Scores\" WHERE \"UpdatedAt\" >= CURRENT_DATE;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 3,
      "title": "Unique Players",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(DISTINCT \"UserId\") AS \"Players\" FROM \"Scores\";",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "purple", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 4,
      "title": "Board Sizes Played",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT COUNT(DISTINCT (\"BoardWidth\", \"BoardHeight\")) AS \"Sizes\" FROM \"Scores\";",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "orange", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 5,
      "title": "Recent Submissions",
      "description": "Latest score submissions/improvements",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT s.\"UpdatedAt\" AS \"Time\", u.\"DisplayName\" AS \"Player\", s.\"BoardWidth\" || 'x' || s.\"BoardHeight\" AS \"Board Size\", ROUND(s.\"Time\"::numeric, 3) AS \"Solve Time (s)\", s.\"Seed\", u.\"Flagged\", s.\"GameId\" AS \"Game ID\" FROM \"Scores\" s JOIN \"Users\" u ON s.\"UserId\" = u.\"Id\" WHERE s.\"UpdatedAt\" >= $__timeFrom()::timestamptz AND s.\"UpdatedAt\" <= $__timeTo()::timestamptz ORDER BY s.\"UpdatedAt\" DESC LIMIT 100;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Flagged" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "true": { "text": "YES", "color": "red" }, "false": { "text": "", "color": "transparent" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Game ID" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Time", "desc": true }]
      }
    },
    {
      "id": 6,
      "title": "Scores by Board Size",
      "description": "Number of scores per board dimension",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT s.\"BoardWidth\" || 'x' || s.\"BoardHeight\" AS \"Board Size\", COUNT(*) AS \"Scores\" FROM \"Scores\" s JOIN \"Users\" u ON s.\"UserId\" = u.\"Id\" WHERE u.\"Flagged\" = false GROUP BY s.\"BoardWidth\", s.\"BoardHeight\" ORDER BY COUNT(*) DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "xField": "Board Size",
        "orientation": "horizontal"
      }
    },
    {
      "id": 7,
      "title": "Score Volume Over Time",
      "description": "Submissions per day",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT $__timeGroup(s.\"UpdatedAt\", '1d') AS time, COUNT(*) AS \"Submissions\" FROM \"Scores\" s WHERE $__timeFilter(s.\"UpdatedAt\") GROUP BY 1 ORDER BY 1;",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "lineWidth": 0
          },
          "color": { "fixedColor": "green", "mode": "fixed" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "id": 20,
      "title": "Leaderboards",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "Leaderboard — 10x10",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT ROW_NUMBER() OVER (ORDER BY s.\"Time\" ASC) AS \"#\", u.\"DisplayName\" AS \"Player\", ROUND(s.\"Time\"::numeric, 3) AS \"Time (s)\", s.\"GameId\" AS \"Game ID\" FROM \"Scores\" s JOIN \"Users\" u ON s.\"UserId\" = u.\"Id\" WHERE s.\"BoardWidth\" = 10 AND s.\"BoardHeight\" = 10 AND u.\"Flagged\" = false ORDER BY s.\"Time\" ASC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Game ID" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 9,
      "title": "Leaderboard — 20x20",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT ROW_NUMBER() OVER (ORDER BY s.\"Time\" ASC) AS \"#\", u.\"DisplayName\" AS \"Player\", ROUND(s.\"Time\"::numeric, 3) AS \"Time (s)\", s.\"GameId\" AS \"Game ID\" FROM \"Scores\" s JOIN \"Users\" u ON s.\"UserId\" = u.\"Id\" WHERE s.\"BoardWidth\" = 20 AND s.\"BoardHeight\" = 20 AND u.\"Flagged\" = false ORDER BY s.\"Time\" ASC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Game ID" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 11,
      "title": "Leaderboard — 40x40",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT ROW_NUMBER() OVER (ORDER BY s.\"Time\" ASC) AS \"#\", u.\"DisplayName\" AS \"Player\", ROUND(s.\"Time\"::numeric, 3) AS \"Time (s)\", s.\"GameId\" AS \"Game ID\" FROM \"Scores\" s JOIN \"Users\" u ON s.\"UserId\" = u.\"Id\" WHERE s.\"BoardWidth\" = 40 AND s.\"BoardHeight\" = 40 AND u.\"Flagged\" = false ORDER BY s.\"Time\" ASC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Game ID" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 12,
      "title": "Leaderboard — 100x100",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT ROW_NUMBER() OVER (ORDER BY s.\"Time\" ASC) AS \"#\", u.\"DisplayName\" AS \"Player\", ROUND(s.\"Time\"::numeric, 3) AS \"Time (s)\", s.\"GameId\" AS \"Game ID\" FROM \"Scores\" s JOIN \"Users\" u ON s.\"UserId\" = u.\"Id\" WHERE s.\"BoardWidth\" = 100 AND s.\"BoardHeight\" = 100 AND u.\"Flagged\" = false ORDER BY s.\"Time\" ASC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Game ID" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 13,
      "title": "Leaderboard — All (by size)",
      "description": "All scores across all board sizes, sorted by size then time",
      "type": "table",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 43 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT s.\"BoardWidth\" || 'x' || s.\"BoardHeight\" AS \"Board Size\", ROW_NUMBER() OVER (PARTITION BY s.\"BoardWidth\", s.\"BoardHeight\" ORDER BY s.\"Time\" ASC) AS \"#\", u.\"DisplayName\" AS \"Player\", ROUND(s.\"Time\"::numeric, 3) AS \"Time (s)\", s.\"GameId\" AS \"Game ID\" FROM \"Scores\" s JOIN \"Users\" u ON s.\"UserId\" = u.\"Id\" WHERE u.\"Flagged\" = false ORDER BY s.\"BoardWidth\" ASC, s.\"BoardHeight\" ASC, s.\"Time\" ASC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Game ID" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "id": 10,
      "title": "Flagged Users' Scores",
      "description": "All scores belonging to flagged accounts",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 55 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "rawSql": "SELECT u.\"DisplayName\" AS \"Player\", u.\"Email\", u.\"FlagReason\" AS \"Flag Reason\", s.\"BoardWidth\" || 'x' || s.\"BoardHeight\" AS \"Board Size\", ROUND(s.\"Time\"::numeric, 3) AS \"Time (s)\", s.\"Seed\", s.\"UpdatedAt\" AS \"Submitted\", s.\"Id\" AS \"Score ID\" FROM \"Scores\" s JOIN \"Users\" u ON s.\"UserId\" = u.\"Id\" WHERE u.\"Flagged\" = true ORDER BY s.\"UpdatedAt\" DESC;",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Score ID" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Submitted", "desc": true }]
      }
    }
  ]
}
