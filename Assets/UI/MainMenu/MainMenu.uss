/* MainMenu-specific styles. Shared components live in Shared.uss. */
/* .screen, .screen-instance, .overlay-instance, .menu-btn moved to Shared.uss */

/* Menu panel — one per menu state, toggleable via screen--hidden */
.menu-panel {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 24px 0;
}

/* Title */
.title {
    width: 80%;
    max-width: 500px;
    height: 100px;
    margin-bottom: 60px;
    flex-shrink: 1;
    background-image: url("/Assets/Art/Sprites/title.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-primary);
}

/* Preset grid + custom-panel moved to Shared.uss */


/* Start button — green accent */
.start-btn {
    color: var(--text-on-accent);
    background-color: var(--accent-approval);
}

.start-btn:hover {
    background-color: var(--accent-approval-hover);
}

.start-btn:active {
    background-color: var(--accent-approval-active);
}

/* Continue button — teal accent to distinguish from "Play" / "New Board" */
.continue-btn {
    color: var(--text-on-accent);
    background-color: var(--accent-confirm);
}

.continue-btn:hover {
    background-color: var(--accent-confirm-hover);
}

.continue-btn:active {
    background-color: var(--accent-confirm-active);
}

/* Play choice row — side-by-side Singleplayer / Multiplayer */
.play-choice-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 6px;
}

.play-choice-btn {
    width: 180px;
    margin: 0 6px;
}

/* Coming soon stub label (multiplayer sub-menu) */
.coming-soon-text {
    margin-top: 8px;
    font-size: 18px;
    color: var(--text-secondary);
    -unity-text-align: middle-center;
}

/* Info panel (anchored above the info button) */
.info-panel {
    position: absolute;
    bottom: 72px;
    right: 16px;
    background-color: var(--bg-panel);
    border-radius: 10px;
    padding: 16px 20px;
    align-items: flex-end;
}

.info-text {
    font-size: 16px;
    color: var(--text-secondary);
    margin-bottom: 4px;
    -unity-text-align: upper-right;
}

.info-credit {
    color: var(--text-primary);
    margin-top: 12px;
    margin-bottom: 0;
}

.info-link {
    font-size: 16px;
    color: var(--accent-info);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px 0;
    -unity-text-align: upper-right;
}

.info-link:hover {
    color: var(--accent-info);
}

/* (Link icon buttons and link-row moved to Shared.uss icon-btn / icon-row) */

/* Section label */
.section-label {
    font-size: 28px;
    color: var(--text-primary);
    margin-bottom: 16px;
    flex-shrink: 1;
}

/* Subtitle / placeholder text */
.placeholder-text {
    font-size: 24px;
    color: var(--text-secondary);
    margin-bottom: 32px;
    flex-shrink: 1;
}

/* Settings panel, account forms, components all moved to Shared.uss */
