/* ====================================================================
   Shared.uss — Reusable UI components
   Add <Style src="Shared.uss" /> to every UXML document that uses
   any of these classes. ThemeColors.uss must also be applied to the
   panel root (via UIThemeApplier) for the var() references to resolve.

   ── Text scale ────────────────────────────────────────────────────────
   Display  28px+  --text-on-accent      Timer, victory msg, hero overlays
   Title    20px   --text-primary    Screen headers, modal titles
   Body     16px   --text-primary    Panel content, buttons, entry values
   Secondary 14px  --text-secondary  Descriptions, labels, muted helpers
   Small    13px   --text-dim        Tabs, filter/nav btns, dates
   ==================================================================== */

/* ── Visibility ──────────────────────────────────────────────────── */

.screen--hidden {
    display: none;
}

.modal--hidden {
    display: none;
}

/* ── Loading Overlay ──────────────────────────────────────────────── */

.loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-loading-overlay);
    align-items: center;
    justify-content: center;
}

.loading-label {
    font-size: 32px;
    color: var(--text-primary);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 24px;
}

/* Shared progress bar base — used by loading overlay, hub gen progress, replay seek */
.progress-bar {
    height: 8px;
    background-color: var(--bg-track);
    border-radius: 4px;
    overflow: hidden;
}

.progress-bar__fill {
    height: 100%;
    width: 0%;
    background-color: var(--accent-info);
    border-radius: 4px;
}

/* Loading overlay progress bar — fixed width, centered */
.loading-bar-track {
    width: 300px;
    height: 8px;
    background-color: var(--bg-track);
    border-radius: 4px;
    margin-top: 20px;
    overflow: hidden;
}

.loading-bar-fill {
    height: 100%;
    width: 0%;
    background-color: var(--accent-info);
    border-radius: 4px;
}

.loading-percent {
    font-size: 18px;
    color: var(--text-dim);
    margin-top: 8px;
    -unity-text-align: middle-center;
}

/* ── Icon Button ─────────────────────────────────────────────────── */
/*
   Circular 48×48 icon button. Add an .icon-btn__icon child carrying a
   named icon class (e.g. .icon--close).
   For groups, wrap buttons in an .icon-row container with a corner
   modifier.
*/

.icon-btn {
    width: 48px;
    height: 48px;
    padding: 8px;
    background-color: var(--bg-btn);
    border-radius: 24px;
    border-width: 0;
}

.icon-btn:hover {
    background-color: var(--bg-btn-hover);
}

.icon-btn__icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-secondary);
}

.icon-btn:hover .icon-btn__icon {
    -unity-background-image-tint-color: var(--text-primary);
}

.icon-btn--gold {
    background-color: var(--accent-gold-btn);
}

.icon-btn--gold:hover {
    background-color: var(--accent-gold-btn-hover);
}

.icon-btn--gold .icon-btn__icon,
.icon-btn--gold:hover .icon-btn__icon {
    -unity-background-image-tint-color: var(--text-on-accent);
}

/* ── Icon Row ────────────────────────────────────────────────────── */
/*
   Absolutely-positioned row of icon buttons. Combine with a corner
   modifier: --top-left / --top-right / --bottom-left / --bottom-right.
*/

.icon-row {
    position: absolute;
    flex-direction: row;
    align-items: center;
}

.icon-row .icon-btn {
    margin-left: 8px;
}

.icon-row--top-left {
    top: 16px;
    left: 16px;
}

.icon-row--top-right {
    top: 16px;
    right: 16px;
}

.icon-row--bottom-left {
    bottom: 16px;
    left: 16px;
}

.icon-row--bottom-right {
    bottom: 16px;
    right: 16px;
}

/* ── Breadcrumb Label ────────────────────────────────────────────── */

.breadcrumb-label {
    font-size: 16px;
    color: var(--text-secondary);
    -unity-text-align: middle-left;
    margin-left: 4px;
}

/* ── Named Icons ─────────────────────────────────────────────────── */

.icon--close {
    background-image: url("/Assets/Art/Icons/close.png");
}

.icon--info {
    background-image: url("/Assets/Art/Icons/info.png");
}

.icon--account {
    background-image: url("/Assets/Art/Icons/account.png");
}

.icon--github {
    background-image: url("/Assets/Art/Icons/github.png");
}

.icon--discord {
    background-image: url("/Assets/Art/Icons/discord.png");
}

.icon--arrow-back {
    background-image: url("/Assets/Art/Icons/arrow_back.png");
}


.icon--trophy {
    background-image: url("/Assets/Art/Icons/trophy.png");
}

.icon--arrow-lane-preview {
    background-image: url("/Assets/Art/Icons/arrow_lane_preview.png");
}


.icon--refresh {
    background-image: url("/Assets/Art/Icons/refresh.png");
}

.icon--copy {
    background-image: url("/Assets/Art/Icons/copy.png");
}

.icon--visible-on {
    background-image: url("/Assets/Art/Icons/visible_on.png");
}

.icon--visible-off {
    background-image: url("/Assets/Art/Icons/visible_off.png");
}

.icon--joystick {
    background-image: url("/Assets/Art/Icons/joystick.png");
}

.icon--keyboard {
    background-image: url("/Assets/Art/Icons/keyboard.png");
}

.icon--data-table {
    background-image: url("/Assets/Art/Icons/data_table.png");
}


/* ── HUD Icon Button ──────────────────────────────────────────────── */
/*
   Base: absolute-positioned circular button.
   Combine with a position modifier:
     .hud-icon-btn--top-left / --top-right / --bottom-left / --bottom-right
   For image-only buttons add .hud-icon-btn--padded instead of relying on
   font-size centering. Child images should use .hud-icon-btn__icon.
*/

.hud-icon-btn {
    position: absolute;
    width: 48px;
    height: 48px;
    font-size: 28px;
    color: var(--text-secondary);
    background-color: var(--bg-btn);
    border-radius: 24px;
    border-width: 0;
    -unity-text-align: middle-center;
}

.hud-icon-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-btn-hover);
}

.hud-icon-btn:active {
    background-color: var(--bg-btn-active);
}

/* Position modifiers */
.hud-icon-btn--top-left {
    top: 16px;
    left: 16px;
}

.hud-icon-btn--top-right {
    top: 16px;
    right: 16px;
}

.hud-icon-btn--bottom-left {
    bottom: 16px;
    left: 16px;
}

.hud-icon-btn--bottom-right {
    bottom: 16px;
    right: 16px;
}

/* Toggled/active state — blue tint */
.hud-icon-btn--active {
    color: var(--accent-info);
    background-color: var(--accent-info-bg-mid);
}

.hud-icon-btn--active:hover {
    background-color: var(--accent-info-bg-strong);
}

/* Use instead of text when the button contains a background-image child */
.hud-icon-btn--padded {
    padding: 8px;
}

/* Standard icon child element — default tint matches the text colour */
.hud-icon-btn__icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-secondary);
}

.hud-icon-btn:hover .hud-icon-btn__icon {
    -unity-background-image-tint-color: var(--text-primary);
}

/* ── Empty State ─────────────────────────────────────────────────── */
/*
   Muted centered placeholder used when a list or panel has no content.
*/

.empty-state {
    font-size: 16px;
    color: var(--text-dim);
    -unity-text-align: middle-center;
    flex-grow: 1;
    padding: 40px;
    white-space: normal;
}

/* ── Toast Notification ──────────────────────────────────────────── */
/*
   Floating notification bar. Position with a modifier class per screen
   (e.g., .victory-toast, .lb-toast). Add .toast__text for the message
   and optional .toast__action-btn for retry.
*/

.toast {
    position: absolute;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-panel);
    border-radius: 8px;
    padding: 8px 14px;
}

.toast__text {
    font-size: 13px;
    color: var(--text-secondary);
    margin-right: 8px;
}

.toast__action-btn {
    font-size: 12px;
    color: var(--text-primary);
    background-color: var(--bg-btn);
    border-radius: 5px;
    border-width: 0;
    padding: 4px 10px;
}

.toast__action-btn:hover {
    background-color: var(--bg-btn-hover);
}

.toast__action-btn:active {
    background-color: var(--bg-btn-active);
}

/* ── Context Menu ────────────────────────────────────────────────── */
/*
   Floating popup positioned in C# via style.top/bottom/left/right.
   Add .context-menu__btn children for each action.
*/

.context-menu {
    position: absolute;
    background-color: var(--bg-panel);
    border-radius: 8px;
    padding: 4px 0;
    min-width: 140px;
}

.context-menu__btn {
    font-size: 16px;
    color: var(--text-primary);
    background-color: transparent;
    border-width: 0;
    padding: 8px 16px;
    -unity-text-align: middle-left;
}

.context-menu__btn:hover {
    background-color: var(--bg-btn);
}

.context-menu__btn--danger {
    color: var(--text-danger);
}

/* ── Modal Instance ──────────────────────────────────────────────── */
/* ── Shared layout classes ────────────────────────────────────────── */
/* Used across MainMenu, Coop Hub, Coop Game, and any future scenes.  */

.screen-instance {
    flex-grow: 1;
}

.screen {
    flex-grow: 1;
    background-color: var(--bg-screen);
}

.overlay-instance {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* Standard menu button — reused in menus, modals, hub toolbar */
.menu-btn {
    width: 300px;
    padding: 14px 0;
    margin: 6px 0;
    font-size: 28px;
    color: var(--text-primary);
    background-color: var(--bg-btn);
    border-radius: 8px;
    border-width: 0;
    -unity-text-align: middle-center;
    flex-shrink: 1;
}

.menu-btn:hover {
    background-color: var(--bg-btn-hover);
}

.menu-btn:active {
    background-color: var(--bg-btn-active);
}

.menu-btn--danger {
    color: var(--text-danger);
}

.menu-btn--danger:hover {
    background-color: var(--bg-btn-hover);
}

.menu-btn--ghost {
    background-color: transparent;
    border-width: 1px;
    border-color: var(--border-secondary);
}

.menu-btn--ghost:hover {
    background-color: var(--bg-hover);
}

/*
   Wrapper element for ConfirmModal template instances.
   Hidden by default; shown/hidden from C# via ConfirmModal.Show/Hide.
*/

.modal-instance {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: none;
}

/* ── Modal ────────────────────────────────────────────────────────── */

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg-overlay);
    align-items: center;
    justify-content: center;
}

.modal-box {
    background-color: var(--bg-panel);
    border-radius: 12px;
    padding: 32px 48px;
    align-items: center;
    max-width: 90%;
}

.modal-label {
    font-size: 20px;
    color: var(--text-primary);
    margin-bottom: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.modal-sublabel {
    font-size: 16px;
    color: var(--text-secondary);
    margin-bottom: 16px;
    margin-top: -12px;
}

.modal-buttons {
    flex-direction: row;
}

.modal-btn {
    min-width: 120px;
    padding: 10px 16px;
    font-size: 16px;
    margin: 0 8px;
    color: var(--text-primary);
    background-color: var(--bg-btn);
    border-radius: 8px;
    border-width: 0;
    -unity-text-align: middle-center;
}

.modal-btn:hover {
    background-color: var(--bg-btn-hover);
}

.modal-btn:active {
    background-color: var(--bg-btn-active);
}

/* Destructive action — filled red background */
.modal-btn--danger {
    background-color: var(--accent-danger-btn);
}

.modal-btn--danger:hover {
    background-color: var(--accent-danger-btn-hover);
}

/* Small dismiss button, absolute-positioned inside .modal-box */
.modal-close-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    background-color: transparent;
    border-width: 0;
    border-radius: 16px;
    align-items: center;
    justify-content: center;
}

.modal-close-btn:hover {
    background-color: var(--bg-btn-hover);
}

.modal-close-btn__icon {
    width: 18px;
    height: 18px;
    -unity-background-image-tint-color: var(--text-dim);
}

.modal-close-btn:hover .modal-close-btn__icon {
    -unity-background-image-tint-color: var(--text-primary);
}

/* ── Screen Header ────────────────────────────────────────────────── */
/*
   Horizontal header row: back button + title + optional right-side controls.
   Screens should add their own margin-bottom.
*/

.screen-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.screen-header__back-btn {
    width: 40px;
    height: 40px;
    padding: 7px;
    background-color: var(--bg-btn);
    border-radius: 20px;
    border-width: 0;
    margin-right: 12px;
    flex-shrink: 0;
}

.screen-header__back-btn:hover {
    background-color: var(--bg-btn-hover);
}

.screen-header__back-btn .hud-icon-btn__icon {
    -unity-background-image-tint-color: var(--text-primary);
}

.screen-header__back-btn:hover .hud-icon-btn__icon {
    -unity-background-image-tint-color: var(--text-primary);
}

.screen-header__title {
    font-size: 20px;
    color: var(--text-primary);
    -unity-font-style: bold;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

/* ── Tab Bar ──────────────────────────────────────────────────────── */
/*
   Horizontal row of tabs with a blue underline on the active tab.
   Screens should add their own margin-bottom.
*/

.tab-bar {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
}

.tab-bar__tab {
    font-size: 15px;
    color: var(--text-secondary);
    background-color: var(--bg-nav);
    border-width: 0;
    padding: 8px 16px;
    margin: 0 2px;
    border-radius: 6px;
}

.tab-bar__tab:hover {
    background-color: var(--bg-nav-hover);
}

.tab-bar__tab--active {
    color: var(--text-primary);
    background-color: var(--bg-nav-active);
    border-bottom-width: 2px;
    border-bottom-color: var(--accent-info);
}

/* ── Toggle Group ─────────────────────────────────────────────────── */
/*
   Pill-shaped button pair (e.g. Local / Global).
   First button gets --first, last button gets --last.
*/

.toggle-group {
    flex-direction: row;
    flex-shrink: 0;
}

.toggle-group__btn {
    font-size: 13px;
    color: var(--text-secondary);
    background-color: var(--bg-nav);
    border-width: 0;
    padding: 5px 10px;
    margin: 0 1px;
}

.toggle-group__btn:hover {
    background-color: var(--bg-nav-hover);
}

.toggle-group__btn--active {
    color: var(--text-primary);
    background-color: var(--bg-nav-active);
}

.toggle-group__btn--first {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

.toggle-group__btn--last {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* ── Filter Row ───────────────────────────────────────────────────── */
/*
   Row of transparent filter/sort buttons; active one gets a filled pill.
   Screens should add their own margin-bottom.
*/

.filter-row {
    flex-direction: row;
    justify-content: center;
    flex-shrink: 0;
}

.filter-row__btn {
    font-size: 13px;
    color: var(--text-dim);
    background-color: transparent;
    border-width: 0;
    padding: 4px 12px;
    margin: 0 2px;
    border-radius: 4px;
}

.filter-row__btn:hover {
    background-color: var(--bg-btn);
}

.filter-row__btn--active {
    color: var(--text-primary);
    background-color: var(--bg-nav-active);
}

/* ── List Screen (shared base for Leaderboard + Co-op Hub) ───────── */
/*
   Full-screen list view: bg-screen + padding + screen-header + filter-row
   + scrollable row list + modals. Apply .list-screen to the root element
   of any scene using this pattern.
*/

.list-screen {
    flex-grow: 1;
    background-color: var(--bg-screen);
    padding: 16px;
    overflow: hidden;
    height: 100%;
}

.list-screen .screen-header {
    margin-bottom: 12px;
}

.list-screen .filter-row {
    margin-bottom: 10px;
}

/* Compact modal overrides for list screens */
.list-screen .modal-box {
    padding: 28px 40px;
}

.list-screen .modal-label {
    font-size: 20px;
    margin-bottom: 20px;
}

.list-screen .modal-btn {
    min-width: 100px;
    font-size: 16px;
    border-radius: 6px;
    margin: 0 6px;
}

/* Shared scrollable list area */
.list-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.list-scroll .unity-scroller--vertical {
    width: 8px;
    margin: 0;
    padding: 0;
}

.list-scroll .unity-scroller--vertical .unity-slider {
    margin: 0;
    padding: 0;
}

.list-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--scrollbar-track);
    border-width: 0;
}

.list-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--scrollbar-thumb);
    border-radius: 4px;
    border-width: 0;
}

.list-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--scrollbar-thumb-hover);
}

.list-scroll .unity-scroller--vertical .unity-repeat-button {
    display: none;
    height: 0;
    min-height: 0;
}

/* Shared refresh button (used in tab bars and toolbars) */
.list-refresh-btn {
    width: 30px;
    height: 30px;
    padding: 5px;
    background-color: var(--bg-btn);
    border-radius: 15px;
    border-width: 0;
    flex-shrink: 0;
    margin-left: 6px;
}

.list-refresh-btn:hover {
    background-color: var(--bg-btn-hover);
}

.list-refresh-btn:active {
    background-color: var(--bg-btn-active);
}

.list-refresh-icon {
    flex-grow: 1;
    background-image: url("/Assets/Art/Icons/refresh.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-secondary);
}

/* ── CustomDropdown ───────────────────────────────────────────────────── */
/*
   Trigger button — add to any VisualElement via CustomDropdown constructor.
   The popup is injected into panel.visualTree so it layers above all UI.
*/

.custom-dropdown {
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg-input);
    border-color: var(--border-normal);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px 12px;

}

.custom-dropdown:hover {
    border-color: var(--border-emphasis);
    background-color: var(--bg-btn);
}

.custom-dropdown--open {
    border-color: var(--border-emphasis);
}

.custom-dropdown__value {
    font-size: 15px;
    color: var(--text-primary);
    flex-grow: 1;
}

.custom-dropdown__arrow {
    width: 12px;
    height: 12px;
    background-image: url("/Assets/Art/Icons/arrow_down.png");
    -unity-background-image-tint-color: var(--text-secondary);
    flex-shrink: 0;
}

.custom-dropdown--open .custom-dropdown__arrow {
    background-image: url("/Assets/Art/Icons/arrow_up.png");
}

/* Popup — injected directly into panel root, positioned absolutely below trigger */
.custom-dropdown__popup {
    background-color: var(--bg-panel);
    border-color: var(--border-emphasis);
    border-width: 1px;
    border-radius: 8px;
    padding: 4px 0;
    max-height: 320px;
    overflow: hidden;
}

.custom-dropdown__item {
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 10px 14px;
    font-size: 15px;
    color: var(--text-primary);
    -unity-text-align: middle-left;
}

.custom-dropdown__item:hover {
    background-color: var(--bg-btn);
}

.custom-dropdown__item--selected {
    color: var(--accent-info);
}

/* ── Keyboard Focus Ring ─────────────────────────────────────────── */
/*
   Applied by FocusNavigator when keyboard navigation is active.
   Hidden on pointer interaction; re-shown on next keyboard input.
*/

/* Double-class selector for high specificity — overrides .menu-btn,
   .start-btn, .icon-btn, etc. which all set their own border/background.
   The invisible reserved border is always present so toggling focus
   never shifts layout — only the color changes. */
.kb-focusable.kb-focusable {
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
}

/* Settings nav tabs: use left-border highlight, not the full focus ring. */
/* Nav tabs are now icon buttons — the standard kb-focusable/kb-focused
   rules work naturally with the rounded 40×40 buttons. */

/* Slider focus ring: absolute overlay inside the track — no layout impact. */
.snap-slider__focus-ring {
    position: absolute;
    top: -3px;
    left: -3px;
    right: -3px;
    bottom: -3px;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

/* Override: slider tracks use the overlay ring, not the global kb-focused border. */
.snap-slider__track.kb-focused.kb-focused {
    border-color: rgba(0, 0, 0, 0);
}

.snap-slider__track.kb-focused .snap-slider__focus-ring {
    border-color: var(--accent-info);
}

.kb-focused.kb-focused {
    border-color: var(--accent-info);
}

/* Toggle pill: match the pill's rounded shape for the focus border. */
.setting-toggle.kb-focusable.kb-focusable {
    border-radius: 17px;
}

.custom-dropdown__item--kb-focused {
    background-color: var(--bg-btn);
}

/* ── Keybind Settings ────────────────────────────────────────────── */

.settings-keybind-group {
    font-size: 13px;
    color: var(--text-dim);
    -unity-font-style: bold;
    margin-top: 12px;
    margin-bottom: 4px;
    letter-spacing: 1px;
}

.settings-keybind-row {
    flex-direction: column;
    margin-bottom: 4px;
}

.settings-keybind-label {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 2px;
}

.settings-keybind-btn-row {
    flex-direction: row;
    align-items: center;
}

.settings-keybind-key-btn {
    min-width: 80px;
    height: 32px;
    background-color: var(--bg-input);
    border-width: 1px;
    border-color: var(--border-normal);
    border-radius: 6px;
    color: var(--text-primary);
    font-size: 14px;
    -unity-text-align: middle-center;
    margin-right: 8px;
    padding-left: 12px;
    padding-right: 12px;
}

.settings-keybind-key-btn:hover {
    border-color: var(--border-emphasis);
}

.settings-keybind-reset-btn {
    width: 32px;
    height: 32px;
    padding: 6px;
}

.settings-keybind-warning {
    font-size: 12px;
    color: var(--text-danger);
    margin-top: 2px;
}

/* ── Co-op Color Picker (in Settings Account tab) ────────────────── */

.settings-coop-color-slot {
    margin: 8px 0;
}

.coop-color-picker__label {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 6px;
}

.coop-color-picker__sliders {
    flex-grow: 1;
}

.coop-color-picker__slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.coop-color-picker__slider-name {
    width: 16px;
    font-size: 13px;
    color: var(--text-dim);
    -unity-font-style: bold;
    margin-right: 4px;
}

.coop-color-picker__hex-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.coop-color-picker__hash {
    font-size: 14px;
    color: var(--text-secondary);
    margin-right: 4px;
}

.coop-color-picker__hex-field {
    width: 120px;
    font-size: 14px;
}

/* ── SnapSlider component ────────────────────────────────────────── */
/* Used by size-select sliders, settings sliders, and color picker.  */

.snap-slider {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.snap-slider__track {
    flex-grow: 1;
    height: 22px;
    margin: 0 4px 0 0;
    background-color: var(--bg-surface-active);
    overflow: visible;
}

.snap-slider__handle {
    position: absolute;
    width: 22px;
    height: 22px;
    background-color: var(--accent-info);
}

.snap-slider__value {
    font-size: 13px;
    color: var(--text-primary);
    width: 34px;
    -unity-text-align: middle-center;
    margin: 0;
    flex-shrink: 0;
}

.snap-slider__btn-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.snap-slider__step-btn {
    width: 22px;
    height: 22px;
    padding: 0;
    margin: 0;
    font-size: 12px;
    color: var(--text-primary);
    background-color: var(--bg-surface-active);
    border-radius: 0;
    border-width: 0;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.snap-slider__step-btn:hover {
    background-color: var(--bg-btn-hover);
}

.snap-slider__step-btn:active {
    background-color: var(--bg-btn-active);
}

.snap-slider__lock-btn {
    width: 22px;
    height: 22px;
    padding: 4px;
    margin: 0;
    background-color: var(--bg-nav);
    border-radius: 0;
    border-width: 0;
    flex-shrink: 0;
}

.snap-slider__lock-btn:hover {
    background-color: var(--bg-nav-hover);
}

.snap-slider__btn--first {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

.snap-slider__btn--middle {
    border-radius: 0;
}

.snap-slider__btn--last {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.snap-slider__lock-icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.snap-slider__lock-icon--locked {
    background-image: url("/Assets/Art/Icons/lock_closed.png");
    -unity-background-image-tint-color: var(--accent-info);
}

.snap-slider__lock-icon--unlocked {
    background-image: url("/Assets/Art/Icons/lock_open.png");
    -unity-background-image-tint-color: var(--text-dim);
}

.setting-snap-slider {
    align-self: stretch;
}

/* ── Preset grid + custom panel (size select pattern) ────────────── */
/* Used by MainMenu singleplayer size select + Co-op Hub host modal. */

.preset-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 560px;
    margin-bottom: 12px;
}

/* Singleplayer mode-tab row (Classic | Endless). Sits above the size
 * picker; small bottom margin so it doesn't crowd the section label. */
.sp-mode-tabs {
    margin-bottom: 8px;
}

.preset-btn {
    width: 160px;
    height: 80px;
    padding: 8px 4px;
    margin: 6px;
    font-size: 16px;
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--border-normal);
    -unity-text-align: middle-center;
    white-space: normal;
}

.preset-btn:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-strong);
}

.preset-btn--selected {
    background-color: var(--bg-surface-active);
    border-color: var(--accent-info);
}

.custom-panel {
    width: 80%;
    max-width: 500px;
    margin-bottom: 12px;
    padding: 8px 12px;
    background-color: var(--bg-surface);
    border-radius: 8px;
}

.preset-custom-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.preset-custom-dim-label {
    font-size: 14px;
    color: var(--text-primary);
    width: 20px;
    margin-right: 4px;
    -unity-text-align: middle-center;
}

/* ── Settings Panel ──────────────────────────────────────────────── */
/* Independent overlay panel (DontDestroyOnLoad singleton). Lives in  */
/* Settings Panel.uxml with its own PanelSettings.                   */

.settings-screen {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.settings-backdrop {
    flex-grow: 1;
    background-color: var(--bg-backdrop);
}

.settings-panel {
    width: 50%;
    max-width: 520px;
    background-color: var(--bg-sidebar);
    align-items: stretch;
    flex-direction: column;
    flex-shrink: 0;
}

.settings-layout {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.settings-nav {
    width: 56px;
    flex-shrink: 0;
    flex-direction: column;
    padding-top: 16px;
    align-items: center;
    background-color: var(--bg-sidebar-nav);
    border-right-width: 1px;
    border-right-color: var(--border-normal);
}

.settings-nav-btn {
    width: 40px;
    height: 40px;
    padding: 8px;
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    margin-bottom: 4px;
}

.settings-nav-btn__icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--text-dim);
}

.settings-nav-btn:hover {
    background-color: var(--bg-btn);
}

.settings-nav-btn:hover .settings-nav-btn__icon {
    -unity-background-image-tint-color: var(--text-secondary);
}

.settings-nav-btn--active {
    border-left-width: 2px;
    border-left-color: var(--accent-info);
    background-color: var(--accent-info-bg);
}

.settings-nav-btn--active .settings-nav-btn__icon {
    -unity-background-image-tint-color: var(--accent-info);
}

.settings-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.settings-scroll .unity-scroller--vertical {
    width: 4px;
    margin-left: -4px;
    margin-right: 0;
    padding: 0;
    transition-property: width, margin-left;
    transition-duration: 0.15s;
}

.settings-scroll:hover .unity-scroller--vertical {
    width: 10px;
    margin-left: -10px;
}

.settings-scroll .unity-scroller--vertical .unity-slider {
    margin: 0;
    padding: 0;
}

.settings-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--scrollbar-track);
    border-width: 0;
}

.settings-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--scrollbar-thumb);
    border-radius: 3px;
    border-width: 0;
}

.settings-scroll:hover .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--scrollbar-thumb-hover);
}

.settings-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: var(--scrollbar-thumb-hover);
}

.settings-scroll .unity-scroller--vertical .unity-repeat-button {
    display: none;
    height: 0;
    min-height: 0;
}

.settings-section {
    padding: 28px 40px 28px 32px;
    max-width: 480px;
    align-items: flex-start;
}

.settings-section--divider {
    border-top-width: 1px;
    border-top-color: var(--border-normal);
}

.settings-section-header {
    font-size: 16px;
    color: var(--text-secondary);
    margin-bottom: 16px;
    -unity-text-align: upper-left;
    -unity-font-style: bold;
}

.settings-section-desc {
    font-size: 14px;
    color: var(--text-dim);
    margin-bottom: 16px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.settings-danger-btn {
    font-size: 14px;
    color: var(--text-on-accent);
    background-color: var(--accent-danger-btn);
    border-width: 0;
    border-radius: 6px;
    padding: 6px 14px;
    align-self: flex-start;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.settings-danger-btn:hover {
    background-color: var(--accent-danger-btn-hover);
}

.about-links {
    flex-direction: row;
    margin-top: 8px;
}

.about-link-icon-btn {
    margin-right: 8px;
}

.settings-account-status {
    font-size: 14px;
    color: var(--text-dim);
    margin-bottom: 12px;
    -unity-text-align: upper-left;
}

/* ── Setting rows ────────────────────────────────────────────────── */

.setting-row {
    max-width: 300px;
    align-self: stretch;
    margin-bottom: 24px;
    align-items: flex-start;
}

.setting-row--toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.setting-row--toggle .setting-label {
    margin-bottom: 0;
}

.setting-label {
    font-size: 16px;
    color: var(--text-primary);
    margin-bottom: 8px;
    -unity-text-align: upper-left;
}

.setting-toggle {
    flex-direction: row;
    align-items: center;
}

.setting-toggle .unity-toggle__input {
    width: 52px;
    height: 28px;
    flex-direction: row;
    align-items: center;
    background-color: var(--bg-surface-active);
    border-radius: 14px;
    border-width: 0;
    padding: 3px;
}

.setting-toggle .unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: var(--text-dim);
    border-width: 0;
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    translate: 0 0;
    transition-duration: 0.15s;
    transition-property: translate, background-color;
}

.setting-toggle:checked .unity-toggle__checkmark {
    background-color: var(--accent-info);
    translate: 24px 0;
}

.setting-toggle .unity-label {
    display: none;
}

/* ── Display name ────────────────────────────────────────────────── */

.settings-display-name-slot {
    align-self: stretch;
    margin-bottom: 4px;
}

/* ── Account forms ───────────────────────────────────────────────── */

.account-form {
    align-self: stretch;
    align-items: stretch;
}

.auth-btn-row {
    flex-direction: row;
    align-self: stretch;
    margin-top: 8px;
}

.auth-btn {
    flex: 1;
    font-size: 16px;
    padding: 10px 0;
    margin: 0 4px;
}

.auth-btn--primary {
    color: var(--text-on-accent);
    background-color: var(--accent-info-btn);
    border-width: 0;
}

.auth-btn--primary:hover {
    background-color: var(--accent-info-btn-hover);
}

.auth-btn--primary:active {
    background-color: var(--accent-info-btn-active);
}

.account-form-title {
    font-size: 16px;
    color: var(--text-primary);
    margin-bottom: 16px;
    -unity-text-align: upper-left;
}

/* ── EditableLabel component ─────────────────────────────────────── */

.editable-label {
    align-self: stretch;
    margin-bottom: 8px;
}

.editable-label__input {
    margin: 0;
    padding: 0;
}

.editable-label__input Label {
    display: none;
}

.editable-label__input .unity-text-field__input {
    font-size: 24px;
    color: var(--text-primary);
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(255, 255, 255, 0);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 12px;
    -unity-text-align: middle-left;
}

.editable-label__input .unity-text-field__input:hover {
    border-color: var(--border-emphasis);
}

.editable-label--editing .editable-label__input .unity-text-field__input {
    background-color: var(--bg-input);
    border-color: var(--border-emphasis);
    -unity-text-align: middle-left;
}

.editable-label--editing .editable-label__input .unity-text-field__input:focus {
    border-color: var(--accent-info);
}

/* ── LabeledField component ──────────────────────────────────────── */

.labeled-field {
    margin-bottom: 8px;
    align-self: stretch;
}

.labeled-field__label-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2px;
}

.labeled-field__label {
    font-size: 14px;
    color: var(--text-secondary);
    -unity-text-align: upper-left;
}

.labeled-field__label-action {
    font-size: 12px;
    color: var(--accent-info);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-right;
}

.labeled-field__label-action:hover {
    color: var(--accent-info);
}

.labeled-field__input {
    margin: 0;
    padding: 0;
}

.labeled-field__input Label {
    display: none;
}

.labeled-field__input .unity-text-field__input {
    font-size: 16px;
    color: var(--text-primary);
    background-color: var(--bg-input);
    border-color: var(--border-normal);
    border-width: 1px;
    border-radius: 6px;
    padding: 8px 10px;
}

.labeled-field__input .unity-text-field__input:focus {
    border-color: var(--accent-info);
}

/* ── Account status/error/success ────────────────────────────────── */

.account-error {
    font-size: 14px;
    color: var(--text-danger);
    margin-bottom: 8px;
    white-space: normal;
}

.account-success {
    font-size: 14px;
    color: var(--text-success);
    margin-bottom: 8px;
    white-space: normal;
}

.account-info-text {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 12px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.account-submit-btn {
    width: auto;
    align-self: stretch;
    font-size: 16px;
    padding: 10px 0;
}

.account-switch-btn {
    font-size: 14px;
    color: var(--accent-info);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 4px 0;
    margin: 0;
    align-self: flex-start;
    -unity-text-align: upper-left;
}

.account-switch-btn:hover {
    color: var(--accent-info);
}
