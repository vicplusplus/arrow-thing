<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Shared.uss" />
    <Style src="GlobalToast.uss" />

    <ui:VisualElement name="global-toast" class="toast global-toast global-toast--hidden" picking-mode="Ignore">
        <ui:Label name="global-toast-text" class="toast__text" />
        <ui:Button name="global-toast-retry" class="toast__action-btn global-toast--hidden" text="Retry" />
        <ui:Button name="global-toast-dismiss" class="global-toast__close-btn" text="✕" />
    </ui:VisualElement>
</ui:UXML>
